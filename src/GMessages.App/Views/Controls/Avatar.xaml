<UserControl
    x:Class="GMessages.App.Views.Controls.Avatar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GMessages.App.Views.Controls">

    <!-- The avatar shows 1 circle, or 2 stacked circles for a group. -->
    <Grid Width="40" Height="40">

        <!-- Only a group shows the back circle. Its photo covers the colored initial. -->
        <Grid
            Width="28"
            Height="28"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Visibility="{x:Bind local:Avatar.ShownIfColor(SecondColor), Mode=OneWay}">
            <Ellipse Fill="{x:Bind local:ColorConverters.ToBrush(SecondColor), Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="White"
                Text="{x:Bind SecondInitial, Mode=OneWay}" />
            <FontIcon
                FontSize="14"
                Foreground="White"
                Glyph="&#xEA8C;"
                Visibility="{x:Bind local:Avatar.PersonIfNoInitial(SecondInitial), Mode=OneWay}" />
            <Ellipse>
                <Ellipse.Fill>
                    <ImageBrush x:Name="SecondPhoto" Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- The photo of the front circle covers the colored initial. An image brush with no source draws nothing. -->
        <Grid
            Width="{x:Bind local:Avatar.FrontSize(SecondColor), Mode=OneWay}"
            Height="{x:Bind local:Avatar.FrontSize(SecondColor), Mode=OneWay}"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom">
            <Ellipse Fill="{x:Bind local:ColorConverters.ToBrush(Color), Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="{x:Bind local:Avatar.InitialSize(SecondColor), Mode=OneWay}"
                Foreground="White"
                Text="{x:Bind Initial, Mode=OneWay}" />

            <!-- A person with no name shows the filled person icon in place of the letter. The phone then has only a
                 number or a short code. -->
            <FontIcon
                FontSize="{x:Bind local:Avatar.PersonSize(SecondColor), Mode=OneWay}"
                Foreground="White"
                Glyph="&#xEA8C;"
                Visibility="{x:Bind local:Avatar.PersonIfNoInitial(Initial), Mode=OneWay}" />
            <Ellipse>
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{x:Bind Image, Mode=OneWay}" Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>
        </Grid>
    </Grid>
</UserControl>

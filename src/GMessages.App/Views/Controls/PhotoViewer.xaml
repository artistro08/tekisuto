<!-- The viewer shows a clicked photo with zoom, or a playing video, over the whole window on a dark scrim. It
     also covers the title bar row, so it tints all of the app. Close, Open in Photos, Download and Save as sit in the
     top-left corner of the title bar row. For a video, Open in Photos reads Open in default app. The theme is always
     dark, so the icons read on the scrim. The viewer is hidden until the code shows it. -->
<UserControl
    x:Class="GMessages.App.Views.Controls.PhotoViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GMessages.App.Views.Controls"
    RequestedTheme="Dark"
    Visibility="Collapsed">

    <!-- The scrim is near black, so the chat under it does not compete with the photo. High contrast uses the window
         color. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PhotoViewerScrimBrush" Color="#D9000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PhotoViewerScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Tab and Shift + Tab cycle inside the scrim, so focus never leaves the viewer. -->
    <Grid
        x:Name="Scrim"
        TabFocusNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The toolbar icons dim while the window is inactive, as the title bar text does. The Activated event of the
             window sets the state through ShowActive. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Activation">
                <VisualState x:Name="Active" />
                <VisualState x:Name="Inactive">
                    <VisualState.Setters>
                        <Setter Target="CloseIcon.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                        <Setter Target="OpenIcon.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                        <Setter Target="OpenWithIcon.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                        <Setter Target="DownloadIcon.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                        <Setter Target="SaveAsIcon.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- The backdrop is the tint on its own layer. Thus the code fades it in and out while the photo grows and
             shrinks. The backdrop, the toolbar and the stage must have no implicit transitions, because the code takes
             their visuals. -->
        <Border
            x:Name="Backdrop"
            Grid.RowSpan="2"
            Background="{ThemeResource PhotoViewerScrimBrush}" />

        <!-- The toolbar sits in the top-left corner of the title bar row, with Close first. The row is 48 px, the
             height of the tall caption buttons. The code of the window lets clicks through to these buttons only. -->
        <StackPanel
            x:Name="ToolbarPanel"
            Margin="8,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">

            <!-- Close is a plain back arrow, as the other icons of the toolbar are. The owner asked for this. -->
            <Button
                x:Name="CloseButton"
                Width="40"
                Height="40"
                AutomationProperties.AutomationId="PhotoViewer.Close"
                AutomationProperties.Name="{x:Bind local:PhotoViewer.CloseText}"
                Click="OnCloseClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind local:PhotoViewer.CloseText}">
                <FontIcon
                    x:Name="CloseIcon"
                    FontSize="16"
                    Glyph="&#xE72B;" />
            </Button>

            <!-- This button reads Open in Photos, or Open in default app for a video. The code names it on each open.
                 With a binding, the first load of the viewer reset the name. -->
            <Button
                x:Name="OpenInPhotosButton"
                Width="40"
                Height="40"
                AutomationProperties.AutomationId="PhotoViewer.OpenInPhotos"
                Click="OnOpenInPhotosClick"
                Style="{StaticResource IconButtonStyle}">
                <FontIcon
                    x:Name="OpenIcon"
                    FontSize="16"
                    Glyph="&#xE8A7;" />
            </Button>

            <!-- Open with opens the app picker of Windows for any photo or video. -->
            <Button
                Width="40"
                Height="40"
                AutomationProperties.AutomationId="PhotoViewer.OpenWith"
                AutomationProperties.Name="{x:Bind local:PhotoViewer.OpenWithText}"
                Click="OnOpenWithClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind local:PhotoViewer.OpenWithText}">
                <FontIcon
                    x:Name="OpenWithIcon"
                    FontSize="16"
                    Glyph="&#xE7AC;" />
            </Button>
            <Button
                x:Name="DownloadButton"
                Width="40"
                Height="40"
                AutomationProperties.AutomationId="PhotoViewer.Download"
                AutomationProperties.Name="{x:Bind local:PhotoViewer.DownloadText}"
                Click="OnDownloadClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind local:PhotoViewer.DownloadText}">
                <FontIcon
                    x:Name="DownloadIcon"
                    FontSize="16"
                    Glyph="&#xE896;" />
            </Button>
            <Button
                x:Name="SaveAsButton"
                Width="40"
                Height="40"
                AutomationProperties.AutomationId="PhotoViewer.SaveAs"
                AutomationProperties.Name="{x:Bind local:PhotoViewer.SaveAsText}"
                Click="OnSaveAsClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind local:PhotoViewer.SaveAsText}">
                <FontIcon
                    x:Name="SaveAsIcon"
                    FontSize="16"
                    Glyph="&#xE792;" />
            </Button>
        </StackPanel>

        <!-- The stage holds the photo or the video. The code grows it from the bubble on open and shrinks it back on
             close. -->
        <Grid x:Name="Stage" Grid.Row="1">

            <!-- The photo centers and fits at 1x, and a smaller photo shows at its own size. Ctrl + mouse wheel and
                 pinch zoom up to 8x. A double-click zooms in or back out. Narrator reads the caption of the photo, or
                 "Photo". A click beside the photo closes the viewer. -->
            <ScrollViewer
                x:Name="Zoomer"
                AutomationProperties.AutomationId="PhotoViewer.Photo"
                Background="Transparent"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                IsTabStop="True"
                MaxZoomFactor="8"
                MinZoomFactor="1"
                SizeChanged="OnZoomerSizeChanged"
                Tapped="OnZoomerTapped"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto"
                ViewChanged="OnZoomerViewChanged"
                ZoomMode="Enabled">
                <Image
                    x:Name="PhotoImage"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DoubleTapped="OnPhotoDoubleTapped"
                    Stretch="Uniform" />
            </ScrollViewer>

            <!-- A clicked video plays here inside the 24 px margin of the photo, with the full transport controls of
                 Windows. The code makes the player PhotoViewer.Video. It shows in place of the photo. -->
            <Grid
                x:Name="VideoHost"
                Margin="24"
                Visibility="Collapsed" />

            <!-- The still is the frame of the bubble, fitted where the video will show. It grows out of the bubble,
                 then the player replaces it when it plays. A still image grows as smoothly as a photo, and a playing
                 video does not. On close, the still is back over the player for the shrink. -->
            <Image
                x:Name="VideoPoster"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False"
                Stretch="Uniform"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>

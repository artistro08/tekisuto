<UserControl
    x:Class="GMessages.App.Views.Controls.TitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Height="48">

    <!-- This control rebuilds the TitleBar of WinUI 3. The Back and ☰ styles come from generic.xaml of Windows App SDK
         2.3. They are 40 px wide with a 2 px margin, subtle fills, and the animated arrow and lines. Here they are
         square and 40 px tall, not stretched to the 44 px of the bar. Back and ☰ keep this default hover and press
         feedback, unlike the icon buttons. The bar uses the expanded 48 px layout. The caption buttons look as Windows
         draws them for a tall title bar, but this control draws them. The caption buttons never get the pointer. The
         title bar input of the window sits over them and reports hover and press, as TitleBarInput shows. -->
    <UserControl.Resources>
        <Style x:Key="TitleBarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="RootGrid"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="Content.(muxc:AnimatedIcon.State)" Value="PointerOver" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Setter Target="Content.(muxc:AnimatedIcon.State)" Value="Pressed" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorDisabledBrush}" />
                                            <Setter Target="Content.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                x:Name="Content"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                AutomationProperties.AccessibilityView="Raw"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A caption button is 46 by 48 px with a 10 px Segoe Fluent Icons glyph. It shows subtle fills on hover and
             press, and a dim glyph while the window is inactive. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="48" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CaptionStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="Glyph.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Inactive">
                                        <VisualState.Setters>
                                            <Setter Target="Glyph.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <TextBlock
                                x:Name="Glyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Content}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close shows the red of Windows with a white glyph on hover and press. -->
        <Style
            x:Key="CloseCaptionButtonStyle"
            BasedOn="{StaticResource CaptionButtonStyle}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CaptionStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="#C42B1C" />
                                            <Setter Target="Glyph.Foreground" Value="White" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="#E5C42B1C" />
                                            <Setter Target="Glyph.Foreground" Value="#B3FFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Inactive">
                                        <VisualState.Setters>
                                            <Setter Target="Glyph.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <TextBlock
                                x:Name="Glyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Content}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <!-- While the window is inactive, the title and the content dim, as in the TitleBar of WinUI 3. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ActivationStates">
                <VisualState x:Name="Active" />
                <VisualState x:Name="Deactivated">
                    <VisualState.Setters>
                        <Setter Target="BackButton.Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Setter Target="PaneToggleButton.Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Setter Target="IconImage.Opacity" Value="0.5" />
                        <Setter Target="TitleText.Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Setter Target="ContentHost.Opacity" Value="0.5" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <!-- The code sets this padding to 2 px after Back or ☰. -->
            <ColumnDefinition x:Name="LeftHeaderPaddingColumn" Width="14" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <!-- The content reaches the caption buttons. In Leaf Calendar, the narrow 8 px drag strip of WinUI 3 sat
                 under the profile picture. The picture reached over the strip to Minimize, so this bar has no
                 strip. -->
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button
            x:Name="BackButton"
            Grid.Column="1"
            Click="OnBackClick"
            Style="{StaticResource TitleBarNavButtonStyle}"
            ToolTipService.ToolTip="Back"
            Visibility="Collapsed">
            <muxc:AnimatedIcon
                Width="16"
                Height="16">
                <animatedvisuals:AnimatedBackVisualSource />
                <muxc:AnimatedIcon.FallbackIconSource>
                    <muxc:FontIconSource
                        FontSize="16"
                        Glyph="&#xE72B;"
                        MirroredWhenRightToLeft="True" />
                </muxc:AnimatedIcon.FallbackIconSource>
            </muxc:AnimatedIcon>
        </Button>

        <Button
            x:Name="PaneToggleButton"
            Grid.Column="2"
            Click="OnPaneToggleClick"
            Style="{StaticResource TitleBarNavButtonStyle}"
            ToolTipService.ToolTip="Navigation"
            Visibility="Collapsed">
            <muxc:AnimatedIcon
                Width="16"
                Height="16">
                <animatedvisuals:AnimatedGlobalNavigationButtonVisualSource />
                <muxc:AnimatedIcon.FallbackIconSource>
                    <muxc:FontIconSource FontSize="16" Glyph="&#xE700;" />
                </muxc:AnimatedIcon.FallbackIconSource>
            </muxc:AnimatedIcon>
        </Button>

        <Image
            x:Name="IconImage"
            Grid.Column="4"
            Width="16"
            Height="16"
            Margin="0,0,16,0"
            VerticalAlignment="Center" />
        <TextBlock
            x:Name="TitleText"
            Grid.Column="5"
            Margin="0,0,8,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />

        <!-- The content fills the row up to the caption buttons. -->
        <ContentPresenter
            x:Name="ContentHost"
            Grid.Column="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center" />

        <StackPanel
            x:Name="CaptionButtons"
            Grid.Column="7"
            Orientation="Horizontal">
            <Button
                x:Name="MinimizeButton"
                AutomationProperties.AutomationId="Minimize"
                AutomationProperties.Name="Minimize"
                Click="OnMinimizeClick"
                Content="&#xE921;"
                Style="{StaticResource CaptionButtonStyle}" />
            <Button
                x:Name="MaximizeButton"
                AutomationProperties.AutomationId="Maximize"
                AutomationProperties.Name="Maximize"
                Click="OnMaximizeClick"
                Content="&#xE922;"
                Style="{StaticResource CaptionButtonStyle}" />
            <Button
                x:Name="CloseButton"
                AutomationProperties.AutomationId="Close"
                AutomationProperties.Name="Close"
                Click="OnCloseClick"
                Content="&#xE8BB;"
                Style="{StaticResource CloseCaptionButtonStyle}" />
        </StackPanel>
    </Grid>
</UserControl>

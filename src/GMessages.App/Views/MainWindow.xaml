<UserControl
    x:Class="GMessages.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GMessages.App.Views.Controls"
    xmlns:local="using:GMessages.App.Views"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    FontFamily="{ThemeResource ContentControlThemeFontFamily}">

    <!-- The window itself draws the Mica through DWM, so nothing here paints a background. See XamlWindow. The font
         of App.xaml with the Fluent emoji passes down to all unstyled text. -->


    <Grid
        x:Name="RootGrid"
        PreviewKeyDown="OnRootPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar shows ☰ on the left. On Settings and Spam & blocked, Back of the title bar takes its place.
             The code sets the title. The profile picture sits beside the caption buttons. It shows the photo of the
             owner, else the default glyph. The bar is 48 px tall like the caption buttons, and the window asks for
             that in code. ☰ and the profile hide while pairing. ☰ and Back are buttons of the title bar itself, as in
             the WinUI Gallery. They have the spacing, the hover and press fills and the animated icons of Windows.
             The lines squeeze, and the arrow nudges. WinUI 2.8 has no TitleBar, so controls:TitleBar rebuilds the
             TitleBar of WinUI 3 and draws the caption buttons. The layout comes from Leaf Calendar. The content fills
             the space up to the caption buttons, with a narrow drag strip. -->
        <controls:TitleBar
            x:Name="AppTitleBar"
            AutomationProperties.AutomationId="Main.TitleBar"
            BackRequested="OnTitleBarBackRequested"
            PaneToggleRequested="OnPaneToggleRequested">

            <!-- The profile button opens Archived, Spam & blocked, Settings and Unpair. It shows only the picture, with
                 no hover or pressed background. It sits at the right end of the content of the title bar. The content
                 fills the space up to the caption buttons. Thus the button moves with the window edge in the same
                 layout pass, as in Leaf Calendar. Only the picture takes clicks, and the empty content around it drags
                 the window. The icon button style has a clear 1 px border, and the button adds 7 px padding. Thus
                 the picture stays 8 px from each side, where it sat before. -->
            <controls:TitleBar.MainContent>
                <Grid x:Name="TitleBarContent">
                    <Button
                        x:Name="ProfileButton"
                        Height="48"
                        Padding="7,0"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="Main.ProfileButton"
                        AutomationProperties.Name="Account"
                        Style="{StaticResource IconButtonStyle}">
                        <muxc:PersonPicture
                            x:Name="ProfilePicture"
                            Width="28"
                            Height="28" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    x:Name="ProfileArchived"
                                    AutomationProperties.AutomationId="Main.Profile.Archived"
                                    Click="OnArchivedClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7B8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="ProfileSpamBlocked"
                                    AutomationProperties.AutomationId="Main.Profile.SpamBlocked"
                                    Click="OnSpamBlockedClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8F8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    AutomationProperties.AutomationId="Main.Profile.Settings"
                                    Click="OnSettingsClick"
                                    Text="Settings">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    AutomationProperties.AutomationId="Main.Profile.Unpair"
                                    Click="OnUnpairClick"
                                    IsEnabled="{x:Bind local:SettingsPage.Not(Settings.IsUnpairing), Mode=OneWay}"
                                    Text="Unpair"
                                    Visibility="{x:Bind Settings.CanUnpair, Mode=OneWay}">
                                    <!-- Segoe Fluent Icons has no phone with a slash. Thus the icon is mobile_off
                                         of Material Symbols, Apache 2.0, outlined and drawn on 16 px. -->
                                    <MenuFlyoutItem.Icon>
                                        <PathIcon Data="M13.667 15.533 0.467 2.333 l0.933 -0.933 L14.6 14.6 l-0.933 0.933ZM3.333 4.283 l1.333 1.333 v6.383 h6.4 l1.6 1.6 v0.4 q0 0.55 -0.392 0.942 T11.333 15.333 H4.667 q-0.55 0 -0.942 -0.392 T3.333 14 v-9.717Zm1.333 9.05 v0.667 h6.667 v-0.667 H4.667Zm1.217 -9.333 -1.317 -1.333 h6.767 v-0.667 H3.9 l-0.467 -0.467 q0.167 -0.383 0.492 -0.625 T4.667 0.667 h6.667 q0.55 0 0.942 0.392 T12.667 2 v8.767 l-1.333 -1.333 v-5.433 H5.883Zm2.117 9.333Zm-0.383 -10.667Z" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <!-- Quit shows only with the tray icon off. Otherwise the menu of the tray quits. -->
                                <MenuFlyoutItem
                                    AutomationProperties.AutomationId="Main.Profile.Quit"
                                    Click="OnQuitClick"
                                    Text="Quit Messages"
                                    Visibility="{x:Bind local:MainWindow.HiddenIf(Settings.ShowTrayIcon), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7E8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </controls:TitleBar.MainContent>
        </controls:TitleBar>

        <!-- The code puts the pairing steps in the body until pairing ends, then the chats. -->
        <Border x:Name="BodyHost" Grid.Row="1" />

        <!-- The open settings page covers the whole body and enters with the standard page entrance. Back of the
             title bar closes it through the code. -->
        <Border x:Name="SettingsHost" Grid.Row="1">
            <Border.ChildTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Border.ChildTransitions>
        </Border>

        <!-- The photo viewer shows a clicked photo over the whole window, the title bar row included. Its toolbar
             sits in that row. -->
        <controls:PhotoViewer x:Name="PhotoViewer" Grid.RowSpan="2" />

        <!-- The download confirmation shows "Saved to Downloads" with Show in folder, at the bottom over everything.
             It closes itself after a few seconds. -->
        <muxc:InfoBar
            x:Name="DownloadedBar"
            Grid.Row="1"
            Margin="16,0,16,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="Main.Downloaded"
            IsOpen="False"
            Severity="Success"
            Title="{x:Bind local:MainWindow.SavedToDownloadsText}">
            <muxc:InfoBar.ActionButton>
                <Button
                    AutomationProperties.AutomationId="Main.Downloaded.ShowInFolder"
                    Click="OnShowInFolderClick"
                    Content="{x:Bind local:MainWindow.ShowInFolderText}" />
            </muxc:InfoBar.ActionButton>
        </muxc:InfoBar>

        <controls:UnpairDialog x:Name="UnpairDialog" Grid.Row="1" />

        <!-- Ctrl + ? opens the shortcut help. -->
        <local:ShortcutHelpDialog x:Name="ShortcutDialog" Grid.Row="1" />
    </Grid>
</UserControl>

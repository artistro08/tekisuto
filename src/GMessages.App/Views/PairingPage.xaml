<UserControl
    x:Class="GMessages.App.Views.PairingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The reason for a sign-out shows only above the sign-in. -->
        <muxc:InfoBar
            Margin="16,16,16,0"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.ShowSignedOutReason, Mode=OneWay}"
            Message="{x:Bind ViewModel.SignedOutReason}"
            Severity="Warning" />

        <!-- The code adds a fresh WebView2 here for each sign-in attempt. -->
        <Border
            x:Name="SignInHost"
            Grid.Row="1"
            Margin="0,8,0,0"
            Visibility="{x:Bind ViewModel.IsSigningIn, Mode=OneWay}" />

        <StackPanel
            Grid.Row="1"
            MaxWidth="440"
            Padding="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.IsWaitingForPhone, Mode=OneWay}">
            <muxc:ProgressRing
                Width="48"
                Height="48"
                AutomationProperties.AutomationId="Pairing.Waiting"
                IsActive="{x:Bind ViewModel.IsWaitingForPhone, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="Pairing.WaitingText"
                Text="Check your phone. If nothing shows up, open Google Messages on your phone."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.IsShowingEmoji, Mode=OneWay}">
            <!-- The emoji shows as the website draws it: the bundled image of Noto Color Emoji, which the code sets.
                 The system emoji font shows only when the image is missing. -->
            <Grid HorizontalAlignment="Center">
                <Image
                    x:Name="EmojiImage"
                    Width="96"
                    Height="96"
                    AutomationProperties.AutomationId="Pairing.Emoji"
                    AutomationProperties.Name="{x:Bind ViewModel.Emoji, Mode=OneWay}"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="EmojiText"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="Pairing.EmojiText"
                    FontSize="96"
                    Text="{x:Bind ViewModel.Emoji, Mode=OneWay}" />
            </Grid>
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Tap this emoji on your phone" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            MaxWidth="440"
            Padding="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="Pairing.Message"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="Pairing.TryAgain"
                Click="OnTryAgainClick"
                Content="Try again"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <Button
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Right"
            AutomationProperties.AutomationId="Pairing.Cancel"
            Click="OnCancelClick"
            Content="Cancel" />
    </Grid>
</UserControl>

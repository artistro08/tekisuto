<!-- The shortcut help lists the wired shortcuts, with the look of the shortcut sheet of Layers. The action sits at
     the left and its keys sit at the right as key caps. The dialog has no button row. The X beside the title,
     Escape or a click on the dimmed window around the dialog closes it. -->
<ContentDialog
    x:Class="GMessages.App.Views.ShortcutHelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="Shortcuts.Dialog"
    AutomationProperties.Name="Keyboard shortcuts"
    Closed="OnClosed"
    Opened="OnOpened">

    <ContentDialog.Resources>
        <!-- A key cap copies the key chip of Layers: quiet control fill, 1 px divider stroke and radius 4. -->
        <Style x:Key="KeyCapStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!-- A row has a divider line above it. The code turns off the line of the first row. -->
        <Style x:Key="ShortcutRowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>

        <!-- The "+" between key caps uses this style. -->
        <Style x:Key="KeyJoinerStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </ContentDialog.Resources>

    <!-- The title holds the heading and the X in the top right corner, with their tops aligned. The title rises by
         the empty space above the letters of the 20 px heading in its line. Thus the gap over the letters matches the
         gap beside them. The negative right margin of the X puts its glyph in from the right edge. That inset
         matches the inset of the heading from the left edge. -->
    <ContentDialog.Title>
        <Grid Margin="0,-7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Top" Text="Keyboard shortcuts" />
            <Button
                Grid.Column="1"
                Width="32"
                Height="32"
                Margin="0,-2,-8,0"
                VerticalAlignment="Top"
                AutomationProperties.AutomationId="Shortcuts.Close"
                AutomationProperties.Name="Close"
                Click="OnCloseClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Close">
                <FontIcon FontSize="16" Glyph="&#xE711;" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <!-- The code fills the rows from ShortcutMap.HelpRows, with a divider between rows that reaches both edges. The
         scroller runs out into the 24 px right padding of the dialog, and the rows keep clear of it. Thus the scroll
         bar sits in that gutter and never covers the keys. -->
    <ScrollViewer Margin="0,0,-24,0">
        <StackPanel x:Name="RowsPanel" Margin="0,0,24,0" />
    </ScrollViewer>
</ContentDialog>
